---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Recognition from '../components/Recognition.astro';
import About from '../components/About.astro';
import Practice from '../components/Practice.astro';
import Ana from '../components/Ana.astro';
import Nebula from '../components/Nebula.astro';
import Training from '../components/Training.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const title = 'Ana Rita Marques — Pedagoga e psicopedagoga inclusiva';
const description =
  'Pedagoga e psicopedagoga. Atendimento em clínica e apoio à sala de aula com estratégias reais para cada criança: material concreto, rotina previsível e regulação sensorial.';
---

<Layout title={title} description={description}>
  <main id="conteudo">
    <Hero />
    <Recognition />
    <About />
    <Practice />
    <Ana />
    <Nebula />
    <Training />
    <Contact />
  </main>
  <Footer />
</Layout>
