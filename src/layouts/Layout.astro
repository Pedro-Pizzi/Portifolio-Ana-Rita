---
import '../styles/global.css';
import { site, links, nav } from '../data/site';

export interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Só emite URLs absolutas quando o domínio real foi configurado (SITE_URL).
// Melhor não ter canonical do que ter canonical apontando para o lugar errado.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
const ogImage = Astro.site
  ? new URL('/og-image.webp', Astro.site).href
  : '/og-image.webp';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.fullName,
  alternateName: site.name,
  jobTitle: 'Pedagoga e psicopedagoga',
  description,
  knowsAbout: [
    'Educação inclusiva',
    'Psicopedagogia',
    'Transtorno do Espectro Autista',
    'Desenvolvimento infantil',
    'Funções executivas',
    'Regulação sensorial',
  ],
  ...(canonical ? { url: canonical } : {}),
  sameAs: [links.instagram, links.linktree],
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'FAIBI — Faculdade de Filosofia, Ciências e Letras de Ibitinga' },
    { '@type': 'CollegeOrUniversity', name: 'PUC Minas' },
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />
    <meta name="theme-color" content="#221a29" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="profile" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${site.name}, pedagoga e psicopedagoga`} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400..650;1,400..500&family=Petrona:ital,wght@0,400..700;1,400..600&display=swap"
    />

    <script is:inline set:html={JSON.stringify(jsonLd)} type="application/ld+json" />

    {/* Arma o motion antes da primeira pintura, para não haver flash de conteúdo.
        Se a aba já nasce oculta, nem arma: transição em aba oculta congela e o
        conteúdo ficaria invisível. */}
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && !document.hidden) {
        document.documentElement.classList.add('js');
      }
    </script>
  </head>

  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

    <header class="topbar" id="topbar" data-topbar>
      <div class="shell topbar-inner">
        <a class="brand" href="#topo" aria-label={`${site.name} — início`}>
          <span class="brand-name">Ana Rita</span>
          <span class="brand-role">Pedagoga &middot; Psicopedagoga</span>
        </a>

        <nav class="nav-desktop" aria-label="Navegação principal">
          {nav.map((item) => (
            <a class="nav-link" href={item.href}>{item.label}</a>
          ))}
          <a class="btn btn-primary nav-cta" href="#contato">Falar comigo</a>
        </nav>

        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="menu-mobile"
          data-menu-open
        >
          <span class="nav-toggle-bars" aria-hidden="true"><i></i><i></i></span>
          <span class="visually-hidden">Abrir menu</span>
        </button>
      </div>
    </header>

    <div class="menu" id="menu-mobile" hidden data-menu>
      <div class="menu-head shell">
        <span class="brand-name">Ana Rita</span>
        <button class="nav-toggle nav-toggle-close" type="button" data-menu-close>
          <span class="nav-toggle-bars is-x" aria-hidden="true"><i></i><i></i></span>
          <span class="visually-hidden">Fechar menu</span>
        </button>
      </div>
      <nav class="menu-list shell" aria-label="Navegação principal (celular)">
        {nav.map((item, i) => (
          <a class="menu-link" href={item.href} style={`--i:${i}`}>{item.label}</a>
        ))}
        <a class="menu-link" href="#contato" style={`--i:${nav.length}`}>Contato</a>
      </nav>
      <div class="menu-foot shell">
        <a href={links.instagram} target="_blank" rel="noopener">{site.handle}</a>
      </div>
    </div>

    <slot />

    <script>
      // ---------------------------------------------------------------- menu
      const menu = document.querySelector<HTMLElement>('[data-menu]');
      const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
      const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');

      if (menu && openBtn && closeBtn) {
        const setMenu = (open: boolean) => {
          menu.toggleAttribute('hidden', !open);
          // deixa o browser aplicar `hidden` antes de animar a entrada
          requestAnimationFrame(() => menu.classList.toggle('is-open', open));
          openBtn.setAttribute('aria-expanded', String(open));
          document.body.style.overflow = open ? 'hidden' : '';
          if (open) closeBtn.focus();
          else openBtn.focus();
        };

        openBtn.addEventListener('click', () => setMenu(true));
        closeBtn.addEventListener('click', () => setMenu(false));
        menu.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('a')) setMenu(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !menu.hasAttribute('hidden')) setMenu(false);
        });
      }

      // ------------------------------------------------------- topbar sólida
      const topbar = document.querySelector<HTMLElement>('[data-topbar]');
      if (topbar) {
        const sentinel = document.createElement('div');
        sentinel.setAttribute('aria-hidden', 'true');
        sentinel.style.cssText = 'position:absolute;top:0;left:0;width:1px;height:80px;pointer-events:none';
        document.body.prepend(sentinel);
        new IntersectionObserver(
          ([entry]) => topbar.classList.toggle('is-stuck', !entry.isIntersecting),
          { threshold: 0 },
        ).observe(sentinel);
      }

      // ------------------------------------------------------------- reveals
      const root = document.documentElement;
      const revealables = document.querySelectorAll<HTMLElement>('[data-reveal]');

      // Desarma o sistema inteiro: sem a classe `js` as regras de reveal não
      // casam, então a opacidade volta a 1 sem depender de transição alguma.
      // É a única saída segura quando a transição está congelada.
      const disableMotion = () => {
        root.classList.remove('js');
        revealables.forEach((el) => el.classList.add('is-in'));
      };

      if (!root.classList.contains('js') || !('IntersectionObserver' in window)) {
        disableMotion();
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        revealables.forEach((el) => io.observe(el));

        // Aba oculta e impressão congelam transições: cai para estático.
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) disableMotion();
        });
        window.addEventListener('beforeprint', disableMotion);

        // Rede de segurança: se depois de 2s algo foi marcado como visível mas
        // continua transparente (render headless, compositor parado), ou se o
        // observer nunca disparou, a página passa a aparecer inteira.
        setTimeout(() => {
          const list = Array.from(revealables);
          const anyRevealed = list.some((el) => el.classList.contains('is-in'));
          const stuck = list.some(
            (el) =>
              el.classList.contains('is-in') &&
              parseFloat(getComputedStyle(el).opacity) < 0.99,
          );
          if (!anyRevealed || stuck || document.hidden) disableMotion();
        }, 2000);
      }
    </script>

    <style>
      /* ------------------------------------------------------------ topbar */
      .topbar {
        position: fixed;
        inset: 0 0 auto;
        z-index: var(--z-nav);
        padding-block: clamp(0.9rem, 1.6vw, 1.35rem);
        transition:
          background-color 0.45s var(--ease-out-quart),
          border-color 0.45s var(--ease-out-quart),
          padding 0.45s var(--ease-out-quart);
        border-bottom: 1px solid transparent;
      }

      .topbar.is-stuck {
        background: oklch(0.155 0.042 312 / 0.82);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-bottom-color: var(--rule-dark);
        padding-block: 0.7rem;
      }

      .topbar-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--sp-s);
      }

      .brand {
        display: grid;
        gap: 2px;
        text-decoration: none;
        color: var(--on-dark);
      }

      .brand-name {
        font-family: var(--font-display);
        font-size: clamp(1.15rem, 2vw, 1.4rem);
        font-weight: 620;
        letter-spacing: -0.015em;
        line-height: 1;
      }

      .brand-role {
        font-size: 0.66rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--violet-300);
      }

      .nav-desktop {
        display: flex;
        align-items: center;
        gap: clamp(1rem, 2.2vw, 2.1rem);
      }

      .nav-link {
        position: relative;
        color: var(--on-dark-soft);
        font-size: var(--step--1);
        font-weight: 500;
        text-decoration: none;
        padding-block: 4px;
        transition: color 0.3s var(--ease-out-quart);
      }

      .nav-link::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: 0;
        height: 1px;
        width: 100%;
        background: var(--ember);
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 0.4s var(--ease-out-quart);
      }

      .nav-link:hover,
      .nav-link:focus-visible {
        color: var(--on-dark);
      }

      .nav-link:hover::after,
      .nav-link:focus-visible::after {
        transform: scaleX(1);
        transform-origin: left;
      }

      .nav-cta {
        padding: 0.7em 1.25em;
      }

      /* ------------------------------------------------------- botão menu */
      .nav-toggle {
        display: none;
        background: none;
        border: 1px solid var(--rule-dark);
        border-radius: var(--r-s);
        padding: 0.7rem;
        cursor: pointer;
        color: var(--on-dark);
      }

      .nav-toggle-bars {
        display: grid;
        gap: 5px;
        width: 20px;
      }

      .nav-toggle-bars i {
        display: block;
        height: 1.5px;
        background: currentColor;
        border-radius: 2px;
        transition: transform 0.35s var(--ease-out-quart);
      }

      .nav-toggle-bars i:last-child {
        width: 65%;
        margin-left: auto;
      }

      .nav-toggle:hover .nav-toggle-bars i:last-child {
        width: 100%;
      }

      .nav-toggle-bars.is-x i {
        height: 1.5px;
      }

      .nav-toggle-bars.is-x i:first-child {
        transform: translateY(3.25px) rotate(45deg);
      }

      .nav-toggle-bars.is-x i:last-child {
        width: 100%;
        transform: translateY(-3.25px) rotate(-45deg);
      }

      /* ------------------------------------------------------- menu mobile */
      .menu {
        position: fixed;
        inset: 0;
        z-index: var(--z-menu);
        display: grid;
        grid-template-rows: auto 1fr auto;
        background: var(--ink-900);
        opacity: 0;
        transition: opacity 0.35s var(--ease-out-quart);
      }

      .menu[hidden] {
        display: none;
      }

      .menu.is-open {
        opacity: 1;
      }

      .menu-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-block: clamp(0.9rem, 1.6vw, 1.35rem);
        color: var(--on-dark);
        border-bottom: 1px solid var(--rule-dark);
      }

      .menu-list {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: var(--sp-xs);
      }

      .menu-link {
        font-family: var(--font-display);
        font-size: clamp(2rem, 9vw, 3rem);
        font-weight: 560;
        letter-spacing: -0.02em;
        color: var(--on-dark);
        text-decoration: none;
        opacity: 0;
        transform: translateY(18px);
      }

      .menu.is-open .menu-link {
        opacity: 1;
        transform: none;
        transition:
          opacity 0.5s var(--ease-out-expo) calc(90ms + var(--i) * 55ms),
          transform 0.6s var(--ease-out-expo) calc(90ms + var(--i) * 55ms);
      }

      .menu-link:hover {
        color: var(--violet-300);
      }

      .menu-foot {
        padding-block: var(--sp-m);
        border-top: 1px solid var(--rule-dark);
        font-size: var(--step--1);
        letter-spacing: 0.04em;
      }

      .menu-foot a {
        color: var(--violet-300);
        text-decoration: none;
      }

      @media (max-width: 860px) {
        .nav-desktop {
          display: none;
        }

        .nav-toggle {
          display: block;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .menu-link {
          opacity: 1;
          transform: none;
        }
      }
    </style>
  </body>
</html>
