---
import '../styles/global.css';
import { site, links, nav } from '../data/site';

export interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Só emite URLs absolutas quando o domínio real foi configurado (SITE_URL).
// Melhor não ter canonical do que ter canonical apontando para o lugar errado.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
const ogImage = Astro.site
  ? new URL('/og-image.webp', Astro.site).href
  : '/og-image.webp';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.fullName,
  alternateName: site.name,
  jobTitle: 'Pedagoga e psicopedagoga',
  description,
  knowsAbout: [
    'Educação inclusiva',
    'Psicopedagogia',
    'Transtorno do Espectro Autista',
    'Desenvolvimento infantil',
    'Funções executivas',
    'Regulação sensorial',
  ],
  ...(canonical ? { url: canonical } : {}),
  sameAs: [links.instagram, links.linktree],
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'FAIBI — Faculdade de Filosofia, Ciências e Letras de Ibitinga' },
    { '@type': 'CollegeOrUniversity', name: 'PUC Minas' },
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />
    <meta name="theme-color" content="#221a29" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="profile" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${site.name}, pedagoga e psicopedagoga`} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400..650;1,400..500&family=Petrona:ital,wght@0,400..700;1,400..600&display=swap"
    />

    <script is:inline set:html={JSON.stringify(jsonLd)} type="application/ld+json" />

  </head>

  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

    <header class="topbar" id="topbar" data-topbar>
      <div class="shell topbar-inner">
        <a class="brand" href="#topo" aria-label={`${site.name} — início`}>
          <span class="brand-name">Ana Rita</span>
          <span class="brand-role">Pedagoga &middot; Psicopedagoga</span>
        </a>

        <nav class="nav-desktop" aria-label="Navegação principal">
          {nav.map((item) => (
            <a class="nav-link" href={item.href}>{item.label}</a>
          ))}
          <a class="btn btn-primary nav-cta" href="#contato">Falar comigo</a>
        </nav>

        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="menu-mobile"
          aria-haspopup="dialog"
          data-menu-open
        >
          <span class="nav-toggle-bars" aria-hidden="true"><i></i><i></i></span>
          <span class="visually-hidden">Abrir menu</span>
        </button>
      </div>
      <span class="scroll-progress" data-scroll-progress aria-hidden="true"></span>
    </header>

    <dialog class="menu" id="menu-mobile" aria-label="Menu de navegação" data-menu>
      <div class="menu-head shell">
        <span class="brand-name">Ana Rita</span>
        <button class="nav-toggle nav-toggle-close" type="button" data-menu-close autofocus>
          <span class="nav-toggle-bars is-x" aria-hidden="true"><i></i><i></i></span>
          <span class="visually-hidden">Fechar menu</span>
        </button>
      </div>
      <nav class="menu-list shell" aria-label="Navegação principal (celular)">
        {nav.map((item) => (
          <a class="menu-link" href={item.href}>{item.label}</a>
        ))}
        <a class="menu-link" href="#contato">Contato</a>
      </nav>
      <div class="menu-foot shell">
        <a href={links.instagram} target="_blank" rel="noopener">{site.handle}</a>
      </div>
    </dialog>

    <slot />

    <script>
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const runningAnimations = new Set<Animation>();

      // O estado natural é sempre visível. A animação não deixa estilos finais.
      const animateIn = (element: HTMLElement, distance = 18, duration = 520) => {
        if (reducedMotion.matches || document.hidden || typeof element.animate !== 'function') return;
        const animation = element.animate(
          [
            { opacity: 0.25, translate: '0 ' + distance + 'px' },
            { opacity: 1, translate: '0 0' },
          ],
          { duration, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'none' },
        );
        runningAnimations.add(animation);
        const forget = () => runningAnimations.delete(animation);
        animation.addEventListener('finish', forget, { once: true });
        animation.addEventListener('cancel', forget, { once: true });
      };
      const finishMotion = () => {
        runningAnimations.forEach((animation) => animation.cancel());
        runningAnimations.clear();
      };

      // O dialog nativo contém o foco e torna o restante da página inerte.
      const topbar = document.querySelector<HTMLElement>('[data-topbar]');
      const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
      const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
      const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');
      const desktop = window.matchMedia('(min-width: 861px)');

      if (menu && openBtn && closeBtn && typeof menu.showModal === 'function') {
        let previousBodyOverflow = '';
        let previousRootOverflow = '';
        let scrollLocked = false;
        let destination: { section: HTMLElement; hash: string } | null = null;
        let returnFocus: HTMLElement = openBtn;

        const unlockScroll = () => {
          if (!scrollLocked) return;
          document.body.style.overflow = previousBodyOverflow;
          document.documentElement.style.overflow = previousRootOverflow;
          scrollLocked = false;
        };

        const focusDestination = (section: HTMLElement) => {
          const heading = section.querySelector<HTMLElement>('h1, h2, h3') ?? section;
          const hadTabindex = heading.hasAttribute('tabindex');
          if (!hadTabindex) heading.setAttribute('tabindex', '-1');
          heading.focus({ preventScroll: true });
          if (!hadTabindex) {
            heading.addEventListener('blur', () => heading.removeAttribute('tabindex'), { once: true });
          }
          section.scrollIntoView({ behavior: reducedMotion.matches ? 'instant' : 'smooth', block: 'start' });
        };

        openBtn.addEventListener('click', () => {
          if (menu.open || desktop.matches) return;
          returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : openBtn;
          menu.showModal();
          previousBodyOverflow = document.body.style.overflow;
          previousRootOverflow = document.documentElement.style.overflow;
          document.body.style.overflow = 'hidden';
          document.documentElement.style.overflow = 'hidden';
          scrollLocked = true;
          openBtn.setAttribute('aria-expanded', 'true');
          closeBtn.focus({ preventScroll: true });
          animateIn(menu, 8, 260);
        });

        // Mantém o ciclo de Tab dentro dos controles, inclusive nas bordas.
        menu.addEventListener('keydown', (event) => {
          if (event.key !== 'Tab' || !menu.open) return;
          const controls = Array.from(menu.querySelectorAll<HTMLElement>(
            'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
          )).filter((element) => element.getClientRects().length > 0 && element.tabIndex >= 0);
          const first = controls[0];
          const last = controls.at(-1);
          if (!first || !last) return;
          const active = document.activeElement;
          if (event.shiftKey && (active === first || !menu.contains(active))) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && (active === last || !menu.contains(active))) {
            event.preventDefault();
            first.focus();
          }
        });
        closeBtn.addEventListener('click', () => menu.close());
        // Escape usa o fechamento nativo; todos os caminhos passam por close.
        menu.addEventListener('close', () => {
          unlockScroll();
          openBtn.setAttribute('aria-expanded', 'false');
          if (destination) {
            const { section, hash } = destination;
            destination = null;
            if (window.location.hash !== hash) history.pushState(null, '', hash);
            focusDestination(section);
          } else {
            const target = returnFocus.getClientRects().length
              ? returnFocus
              : topbar?.querySelector<HTMLElement>('.brand');
            target?.focus({ preventScroll: true });
          }
        });
        menu.addEventListener('click', (event) => {
          const link = (event.target as Element).closest<HTMLAnchorElement>('a');
          if (!link || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          if (link.hash && link.origin === location.origin && link.pathname === location.pathname) {
            const section = document.getElementById(decodeURIComponent(link.hash.slice(1)));
            if (section) {
              event.preventDefault();
              destination = { section, hash: link.hash };
            }
          }
          menu.close();
        });
        desktop.addEventListener('change', () => {
          if (desktop.matches && menu.open) menu.close();
        });
        window.addEventListener('pagehide', () => {
          unlockScroll();
          if (menu.open) menu.close();
        });
        topbar?.setAttribute('data-nav-ready', '');
      }

      // A seção ativa é calculada pela posição atual, em qualquer direção.
      const navigationLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(
        '.nav-desktop a[href^="#"], .menu-list a[href^="#"]',
      ));
      const sectionIds = new Set(navigationLinks.map((link) => link.hash.slice(1)));
      const sections = Array.from(document.querySelectorAll<HTMLElement>('main section[id]'))
        .filter((section) => sectionIds.has(section.id));
      const progress = document.querySelector<HTMLElement>('[data-scroll-progress]');
      let viewportFrame = 0;
      let currentSection = '';

      const updateViewport = () => {
        viewportFrame = 0;
        const pageHeight = document.documentElement.scrollHeight - window.innerHeight;
        const fraction = pageHeight > 0 ? Math.min(1, Math.max(0, window.scrollY / pageHeight)) : 0;
        if (progress) progress.style.transform = 'scaleX(' + fraction + ')';
        topbar?.classList.toggle('is-stuck', window.scrollY > 40);

        const readingLine = (topbar?.getBoundingClientRect().bottom ?? 80) + Math.min(120, window.innerHeight * 0.15);
        let active = '';
        for (const section of sections) {
          if (section.getBoundingClientRect().top <= readingLine) active = section.id;
        }
        if (pageHeight > 0 && window.scrollY >= pageHeight - 4) active = sections.at(-1)?.id ?? active;
        if (active === currentSection) return;
        currentSection = active;
        navigationLinks.forEach((link) => {
          if (link.hash === '#' + active) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      };
      const scheduleViewport = () => {
        if (!viewportFrame) viewportFrame = requestAnimationFrame(updateViewport);
      };
      window.addEventListener('scroll', scheduleViewport, { passive: true });
      window.addEventListener('resize', scheduleViewport);
      window.addEventListener('hashchange', scheduleViewport);
      if ('IntersectionObserver' in window) {
        const navigationObserver = new IntersectionObserver(scheduleViewport, { threshold: [0, 0.25, 1] });
        sections.forEach((section) => navigationObserver.observe(section));
      }
      if ('ResizeObserver' in window) new ResizeObserver(scheduleViewport).observe(document.body);
      updateViewport();

      // Só anima blocos abaixo da dobra inicial; o hero nunca fica oculto.
      const pendingReveals = new Set(Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'))
        .filter((element) => !element.closest('#topo') && element.getBoundingClientRect().top >= window.innerHeight));
      const revealObserver = 'IntersectionObserver' in window
        ? new IntersectionObserver((entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const element = entry.target as HTMLElement;
              revealObserver?.unobserve(element);
              pendingReveals.delete(element);
              animateIn(element);
            }
          }, { threshold: 0.08 })
        : null;
      const observeReveals = () => {
        if (reducedMotion.matches || !revealObserver) return;
        pendingReveals.forEach((element) => {
          if (element.getBoundingClientRect().top < window.innerHeight) pendingReveals.delete(element);
          else revealObserver.observe(element);
        });
      };
      reducedMotion.addEventListener('change', () => {
        if (reducedMotion.matches) {
          finishMotion();
          revealObserver?.disconnect();
        } else observeReveals();
      });
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) finishMotion();
      });
      window.addEventListener('beforeprint', finishMotion);
      observeReveals();
    </script>

    <style>
      /* ------------------------------------------------------------ topbar */
      .topbar {
        position: fixed;
        inset: 0 0 auto;
        z-index: var(--z-nav);
        padding-block: clamp(0.9rem, 1.6vw, 1.35rem);
        transition:
          background-color 0.45s var(--ease-out-quart),
          border-color 0.45s var(--ease-out-quart);
        border-bottom: 1px solid transparent;
      }

      .topbar.is-stuck {
        background: oklch(0.205 0.039 312 / 0.92);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-bottom-color: var(--rule-dark);
      }

      .scroll-progress {
        position: absolute;
        inset: auto 0 -1px;
        height: 2px;
        background: var(--ember);
        opacity: 0.8;
        transform: scaleX(0);
        transform-origin: left;
        pointer-events: none;
      }

      .topbar-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--sp-s);
      }

      .brand {
        display: grid;
        gap: 2px;
        text-decoration: none;
        color: var(--on-dark);
      }

      .brand-name {
        font-family: var(--font-display);
        font-size: clamp(1.15rem, 2vw, 1.4rem);
        font-weight: 620;
        letter-spacing: -0.015em;
        line-height: 1;
      }

      .brand-role {
        font-size: 0.66rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--violet-300);
      }

      .nav-desktop {
        display: flex;
        align-items: center;
        gap: clamp(1rem, 2.2vw, 2.1rem);
      }

      .nav-link {
        position: relative;
        color: var(--on-dark-soft);
        font-size: var(--step--1);
        font-weight: 500;
        text-decoration: none;
        padding-block: 4px;
        transition: color 0.3s var(--ease-out-quart);
      }

      .nav-link::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: 0;
        height: 1px;
        width: 100%;
        background: var(--ember);
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 0.4s var(--ease-out-quart);
      }

      .nav-link:hover,
      .nav-link:focus-visible,
      .nav-link[aria-current='location'] {
        color: var(--on-dark);
      }

      .nav-link:hover::after,
      .nav-link:focus-visible::after,
      .nav-link[aria-current='location']::after {
        transform: scaleX(1);
        transform-origin: left;
      }

      .nav-cta {
        padding: 0.7em 1.25em;
        white-space: nowrap;
      }

      .nav-cta[aria-current='location'] {
        box-shadow: 0 0 0 1px var(--ember);
      }

      /* ------------------------------------------------------- botão menu */
      .nav-toggle {
        display: none;
        background: none;
        border: 1px solid var(--rule-dark);
        border-radius: var(--r-s);
        padding: 0.7rem;
        cursor: pointer;
        color: var(--on-dark);
      }

      .nav-toggle-bars {
        display: grid;
        gap: 5px;
        width: 20px;
      }

      .nav-toggle-bars i {
        display: block;
        height: 1.5px;
        background: currentColor;
        border-radius: 2px;
        transition: transform 0.35s var(--ease-out-quart);
      }

      .nav-toggle-bars i:last-child {
        width: 65%;
        margin-left: auto;
      }

      .nav-toggle:hover .nav-toggle-bars i:last-child {
        width: 100%;
      }

      .nav-toggle-bars.is-x i {
        height: 1.5px;
      }

      .nav-toggle-bars.is-x i:first-child {
        transform: translateY(3.25px) rotate(45deg);
      }

      .nav-toggle-bars.is-x i:last-child {
        width: 100%;
        transform: translateY(-3.25px) rotate(-45deg);
      }

      /* ------------------------------------------------------- menu mobile */
      .menu {
        position: fixed;
        inset: 0;
        z-index: var(--z-menu);
        display: none;
        width: 100%;
        max-width: none;
        height: 100dvh;
        max-height: none;
        margin: 0;
        padding: 0;
        border: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
        background: var(--ink-900);
        color: var(--on-dark);
      }

      .menu[open] {
        display: grid;
        grid-template-rows: auto minmax(min-content, 1fr) auto;
      }

      .menu::backdrop {
        background: var(--ink-900);
      }

      .nav-toggle-close {
        display: block;
      }

      .menu-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-block: clamp(0.9rem, 1.6vw, 1.35rem);
        color: var(--on-dark);
        border-bottom: 1px solid var(--rule-dark);
      }

      .menu-list {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: var(--sp-xs);
        padding-block: var(--sp-l);
      }

      .menu-link {
        font-family: var(--font-display);
        font-size: clamp(2rem, 9vw, 3rem);
        font-weight: 560;
        letter-spacing: -0.02em;
        color: var(--on-dark);
        text-decoration: none;
      }

      .menu-link:hover,
      .menu-link[aria-current='location'] {
        color: var(--violet-300);
      }

      .menu-foot {
        padding-block: var(--sp-m);
        border-top: 1px solid var(--rule-dark);
        font-size: var(--step--1);
        letter-spacing: 0.04em;
      }

      .menu-foot a {
        color: var(--violet-300);
        text-decoration: none;
      }

      @media (max-width: 860px) {
        /* Os links ficam disponíveis até o menu interativo estar pronto. */
        .topbar-inner {
          flex-wrap: wrap;
        }

        .nav-desktop {
          flex: 1 0 100%;
          overflow-x: auto;
          padding-block: 0.4rem;
          gap: 1.2rem;
        }

        .nav-link {
          flex: none;
        }

        .topbar[data-nav-ready] .topbar-inner {
          flex-wrap: nowrap;
        }

        .topbar[data-nav-ready] .nav-desktop {
          display: none;
        }

        .topbar[data-nav-ready] .nav-toggle {
          display: block;
        }
      }
    </style>
  </body>
</html>
