---
import { links, site } from '../data/site';

const channels = [
  {
    label: 'Direct do Instagram',
    who: 'Famílias e escolas',
    href: links.instagramDM,
    detail: site.handle,
  },
  {
    label: 'Perfil no Google',
    who: 'Avaliações e localização',
    href: links.google,
    detail: 'Ana Rita Marques — Psicopedagoga',
  },
  {
    label: 'Sistema A.N.A.',
    who: 'Profissionais e equipes',
    href: links.ana,
    detail: 'anasistema.com.br',
  },
];
---

<section class="contact" id="contato" aria-labelledby="contact-title">
  <div class="shell contact-inner">
    <div class="contact-copy">
      <h2 id="contact-title" data-reveal>
        Vamos conversar sobre <br />
        <span class="em">a sua criança?</span>
      </h2>
      <p class="lede" data-reveal data-delay="1">
        Me conte em duas linhas o que está acontecendo — na escola, em casa ou
        no atendimento. Respondo pelo direct, que é onde consigo dar atenção de
        verdade a cada caso.
      </p>
      <div class="btn-row" data-reveal data-delay="2">
        <a class="btn btn-ember" href={links.instagramDM} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" />
          </svg>
          Chamar no direct
        </a>
        <a class="btn btn-ghost-dark" href={links.instagram} target="_blank" rel="noopener">
          Ver o perfil
        </a>
      </div>
    </div>

    <ul class="channels" data-reveal data-delay="2">
      {channels.map((c) => (
        <li>
          <a href={c.href} target="_blank" rel="noopener">
            <span class="channel-label">{c.label}</span>
            <span class="channel-who">{c.who}</span>
            <span class="channel-detail">{c.detail}</span>
            <svg class="channel-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* A única seção totalmente banhada no roxo da marca: é o pedido de ação. */
  .contact {
    background: var(--violet-700);
    color: var(--on-dark);
    padding-block: var(--sp-2xl);
    position: relative;
    overflow: clip;
  }

  .contact::before {
    content: '';
    position: absolute;
    inset: auto -10% -60% auto;
    width: min(70vw, 720px);
    aspect-ratio: 1;
    background: radial-gradient(circle, oklch(0.585 0.148 303 / 0.75), transparent 65%);
    pointer-events: none;
  }

  .contact-inner {
    position: relative;
    z-index: var(--z-raised);
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .contact h2 {
    font-size: var(--step-5);
    color: var(--on-dark);
  }

  .contact .lede {
    margin-top: var(--sp-m);
    color: oklch(0.93 0.02 305);
  }

  .contact .btn-row {
    margin-top: var(--sp-l);
  }

  /* ------------------------------------------------------------ canais */
  .channels {
    display: grid;
    gap: 0;
    border-top: 1px solid oklch(1 0 0 / 0.22);
  }

  .channels li {
    border-bottom: 1px solid oklch(1 0 0 / 0.22);
  }

  .channels a {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'label arrow'
      'who arrow'
      'detail arrow';
    align-items: center;
    gap: 2px 1rem;
    padding: var(--sp-s) 0;
    text-decoration: none;
    color: inherit;
    transition: transform 0.4s var(--ease-out-quart);
  }

  .channels a:hover {
    transform: translateX(0.85rem);
  }

  .channel-label {
    grid-area: label;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 560;
    line-height: 1.2;
  }

  .channel-who {
    grid-area: who;
    font-size: var(--step--2);
    font-weight: 620;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: oklch(0.86 0.06 60);
  }

  .channel-detail {
    grid-area: detail;
    font-size: var(--step--1);
    color: oklch(0.87 0.03 305);
  }

  .channel-arrow {
    grid-area: arrow;
    width: 22px;
    height: 22px;
    opacity: 0.55;
    transition:
      transform 0.4s var(--ease-out-quart),
      opacity 0.4s var(--ease-out-quart);
  }

  .channels a:hover .channel-arrow {
    opacity: 1;
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .contact-inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .contact .btn-row .btn {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>
