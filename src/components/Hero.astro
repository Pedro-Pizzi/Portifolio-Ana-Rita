---
import { Image } from 'astro:assets';
import portrait from '../assets/images/retrato-estudio.webp';
import { site } from '../data/site';

const credentials = [
  'Pedagogia — FAIBI Ibitinga',
  'Psicopedagogia — PUC Minas',
  'Clínica Evolução + rede pública',
  'Pós em ABA/TEA e Neurociências (em curso)',
];
---

<section class="hero on-dark" id="topo" aria-labelledby="hero-title">
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="shell hero-inner">
    <div class="hero-copy">
      <p class="signature" data-reveal>{site.tagline}</p>

      <h1 id="hero-title" data-reveal data-delay="1">
        Inclusão no aprender, <br />
        no brincar <br />
        <span class="em">e no viver.</span>
      </h1>

      <p class="lede" data-reveal data-delay="2">
        Sou Ana Rita Marques, pedagoga e psicopedagoga. Atendo em clínica e acompanho
        a sala de aula da rede pública construindo estratégias reais para cada
        criança — material concreto, rotina previsível e regulação sensorial.
      </p>

      <div class="btn-row hero-actions" data-reveal data-delay="3">
        <a class="btn btn-primary" href="#contato">
          Falar comigo
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a class="btn btn-ghost-dark" href="#sistema-ana">Conhecer o Sistema A.N.A.</a>
      </div>
    </div>

    <figure class="hero-portrait" data-reveal="blur" data-delay="2">
      <div class="portrait-frame">
        <Image
          src={portrait}
          alt="Ana Rita Marques sorrindo, de colete cinza com o logo da Clínica Evolução, em frente a um fundo claro"
          widths={[360, 540, 720, 900]}
          sizes="(max-width: 960px) 300px, 30vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <figcaption>
        <span class="handle">{site.handle}</span>
        <span class="handle-note">Conteúdo diário sobre inclusão, para famílias e escolas</span>
      </figcaption>
    </figure>
  </div>

  <div class="shell">
    <ul class="credentials" data-reveal data-delay="4">
      {credentials.map((c) => <li>{c}</li>)}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(7.5rem, 15vh, 11rem);
    padding-bottom: var(--sp-l);
    overflow: clip;
  }

  /* Luz difusa atrás do retrato — estática, sem blob animado */
  .hero-glow {
    position: absolute;
    top: -18%;
    right: -8%;
    width: min(60vw, 780px);
    aspect-ratio: 1;
    background: radial-gradient(
      circle,
      oklch(0.505 0.147 304 / 0.42) 0%,
      oklch(0.505 0.147 304 / 0.12) 42%,
      transparent 68%
    );
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: var(--z-raised);
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(260px, 0.65fr);
    gap: clamp(2rem, 6vw, 5.5rem);
    align-items: center;
    padding-bottom: var(--sp-xl);
  }

  .hero-copy .signature {
    margin-bottom: var(--sp-m);
  }

  .hero h1 {
    font-weight: 580;
  }

  .hero .lede {
    margin-top: var(--sp-m);
    color: var(--on-dark-soft);
  }

  .hero-actions {
    margin-top: var(--sp-l);
  }

  /* -------------------------------------------------------------- retrato */
  .hero-portrait {
    display: grid;
    gap: var(--sp-s);
  }

  .portrait-frame {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    /* arco no topo: gesto de livro/retrato, não card genérico */
    border-radius: 50vw 50vw var(--r-m) var(--r-m);
    background: var(--ink-700);
    box-shadow: 0 40px 80px -30px oklch(0 0 0 / 0.7);
  }

  .portrait-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1px solid oklch(1 0 0 / 0.16);
    pointer-events: none;
  }

  .portrait-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
  }

  .hero-portrait figcaption {
    display: grid;
    gap: 3px;
  }

  .handle {
    font-family: var(--font-text);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--violet-300);
  }

  .handle-note {
    font-size: var(--step--2);
    line-height: 1.5;
    color: var(--on-dark-faint);
  }

  /* --------------------------------------------------------- credenciais */
  .credentials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2xs) 0;
    padding-top: var(--sp-m);
    border-top: 1px solid var(--rule-dark);
    font-size: var(--step--2);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--on-dark-faint);
  }

  .credentials li {
    padding-inline: clamp(0.75rem, 2vw, 1.6rem);
  }

  .credentials li:first-child {
    padding-left: 0;
  }

  .credentials li + li {
    border-left: 1px solid var(--rule-dark);
  }

  @media (max-width: 960px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: var(--sp-l);
    }

    .hero-portrait {
      order: -1;
      max-width: 300px;
    }

    .portrait-frame {
      aspect-ratio: 1;
      border-radius: 50vw;
    }

    .credentials li,
    .credentials li:first-child {
      padding-left: 0;
      padding-right: 0;
      flex: 1 1 100%;
      border-left: 0;
    }

    .credentials li + li {
      border-left: 0;
      border-top: 1px solid var(--rule-dark);
      padding-top: var(--sp-2xs);
      margin-top: var(--sp-2xs);
    }
  }

  @media (max-width: 480px) {
    .hero-actions .btn {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>
