---
const done = [
  { title: 'Pedagogia', org: 'FAIBI — Ibitinga' },
  { title: 'Psicopedagogia: atuação em contextos educativos', org: 'PUC Minas' },
  { title: 'Psicologia Escolar', org: null },
  { title: 'Dificuldades e Transtornos de Aprendizagem', org: null },
  { title: 'Leitura, Escrita e Produção de Texto', org: null },
  { title: 'Gestão e Organização da Escola', org: null },
];

const ongoing = [
  { title: 'Análise do Comportamento Aplicada ao TEA', org: 'Pós-graduação' },
  { title: 'Neurociências e Autismo', org: 'Pós-graduação' },
];
---

<section class="training on-dark band-tall" id="formacao" aria-labelledby="training-title">
  <div class="shell">
    <header class="training-head">
      <h2 id="training-title" data-reveal>
        Formação contínua, <br />
        <span class="em">sem enfeite.</span>
      </h2>
      <p class="lede" data-reveal data-delay="1">
        Educação, inclusão, aprendizagem e neurodesenvolvimento. O que já
        terminei e o que ainda estou cursando — separado, para você saber
        exatamente o que está contratando.
      </p>
    </header>

    <div class="training-grid">
      <section class="column" aria-labelledby="col-done" data-reveal data-delay="1">
        <h3 id="col-done" class="column-title">Concluídas</h3>
        <ul>
          {done.map((item) => (
            <li>
              <span class="item-title">{item.title}</span>
              {item.org && <span class="item-org">{item.org}</span>}
            </li>
          ))}
        </ul>
      </section>

      <section class="column column-live" aria-labelledby="col-ongoing" data-reveal data-delay="2">
        <h3 id="col-ongoing" class="column-title">
          Em andamento
          <span class="pulse" aria-hidden="true"></span>
        </h3>
        <ul>
          {ongoing.map((item) => (
            <li>
              <span class="item-title">{item.title}</span>
              <span class="item-org">{item.org}</span>
            </li>
          ))}
        </ul>

        <div class="extras">
          <h4>Complementares</h4>
          <p>
            ABA, TEA na escola, alfabetização de crianças típicas e atípicas,
            Congresso Espectro e simpósios sobre autismo, inclusão e
            neurodesenvolvimento.
          </p>
        </div>
      </section>
    </div>
  </div>
</section>

<style>
  .training-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: end;
    margin-bottom: clamp(3rem, 7vw, 5rem);
  }

  .training-head h2 {
    font-size: var(--step-4);
  }

  .training-head .lede {
    color: var(--on-dark-soft);
    padding-bottom: 0.3rem;
  }

  .training-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .column-title {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding-bottom: var(--sp-xs);
    margin-bottom: var(--sp-m);
    border-bottom: 1px solid var(--rule-dark);
    font-family: var(--font-text);
    font-size: var(--step--1);
    font-weight: 650;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--on-dark-faint);
  }

  .column-live .column-title {
    color: var(--violet-300);
    border-bottom-color: color-mix(in oklch, var(--violet-500) 55%, transparent);
  }

  .pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ember);
    box-shadow: 0 0 0 0 color-mix(in oklch, var(--ember) 70%, transparent);
    animation: pulse 2.8s var(--ease-out-quart) infinite;
  }

  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in oklch, var(--ember) 60%, transparent); }
    60%, 100% { box-shadow: 0 0 0 9px oklch(0.715 0.132 55 / 0); }
  }

  .column ul {
    display: grid;
    gap: var(--sp-s);
  }

  .column li {
    display: grid;
    gap: 3px;
    padding-bottom: var(--sp-s);
    border-bottom: 1px solid var(--rule-dark);
  }

  .column li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .item-title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 520;
    line-height: 1.25;
    color: var(--on-dark);
  }

  .item-org {
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-dark-faint);
  }

  .extras {
    margin-top: var(--sp-l);
    padding: var(--sp-m);
    border-radius: var(--r-m);
    background: var(--ink-800);
  }

  .extras h4 {
    font-family: var(--font-text);
    font-size: var(--step--2);
    font-weight: 650;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ember);
    margin-bottom: 0.6rem;
  }

  .extras p {
    font-size: var(--step--1);
    color: var(--on-dark-soft);
  }

  @media (max-width: 900px) {
    .training-head,
    .training-grid {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse {
      animation: none;
      box-shadow: 0 0 0 4px oklch(0.715 0.132 55 / 0.25);
    }
  }
</style>
